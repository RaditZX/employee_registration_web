generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Candidate {
  id        String   @id @default(cuid())
  fullName  String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  photoUrl  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("candidates")
}
